<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<HBox spacing="20" style="-fx-background-color: #0E0E0F; -fx-padding: 20px;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="">

    <ScrollPane fitToWidth="true" prefWidth="480" minWidth="430" style="-fx-background: transparent; -fx-background-color: transparent;">
        <VBox spacing="12" style="-fx-background-color: #390007; -fx-padding: 18px; -fx-background-radius: 12px;">
            <Label text="Nueva Solicitud de Servicio" style="-fx-text-fill: #F0F4F5; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" />
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Código:" style="-fx-text-fill: #9BA0AB;" />
                <Label fx:id="lblCodigoSolicitud" text="" style="-fx-text-fill: #F0F4F5; -fx-font-weight: bold;" />
            </HBox>

            <Label text="CLIENTE *" style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" />
            <ComboBox fx:id="cmbCliente" promptText="Seleccione un cliente" maxWidth="Infinity" style="-fx-base: #0E0E0F; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px;" />

            <Label text="SERVICIOS Y PAQUETES *" style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" />
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="cmbElemento" promptText="Servicio o paquete" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-base: #0E0E0F; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px;" />
                <Button text="Agregar" onAction="#onAgregarElemento" style="-fx-background-color: #F0F4F5; -fx-text-fill: #390007; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 16px; -fx-cursor: hand;" />
            </HBox>
            <ListView fx:id="lstElementos" prefHeight="120" minHeight="100" style="-fx-base: #390007; -fx-control-inner-background: #0E0E0F; -fx-background-color: #0E0E0F; -fx-selection-bar: #9BA0AB; -fx-selection-bar-non-focused: #9BA0AB;" />
            <Button text="Quitar seleccionado" onAction="#onQuitarElemento" style="-fx-background-color: #9BA0AB; -fx-text-fill: #0E0E0F; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 6px 14px; -fx-cursor: hand;" />
            <Separator style="-fx-background-color: #9BA0AB;" />

            <Label text="FECHA PROGRAMADA (opcional)" style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" />
            <DatePicker fx:id="dpFechaProgramada" promptText="Seleccione una fecha" maxWidth="Infinity" style="-fx-base: #0E0E0F; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px;" />

            <Label text="PRIORIDAD (opcional)" style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" />
            <ComboBox fx:id="cmbPrioridad" promptText="Prioridad" maxWidth="Infinity" style="-fx-base: #0E0E0F; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px;" />

            <Label text="OBSERVACIONES TÉCNICAS (opcional)" style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" />
            <TextArea fx:id="txtObservaciones" promptText="Escriba las observaciones..." wrapText="true" prefRowCount="3" style="-fx-control-inner-background: #0E0E0F; -fx-text-fill: #F0F4F5; -fx-prompt-text-fill: #9BA0AB; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px;" />
            <Separator style="-fx-background-color: #9BA0AB;" />

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Costo estimado:" style="-fx-text-fill: #F0F4F5; -fx-font-size: 14px;" />
                <Label fx:id="lblCostoEstimado" text="\$0" style="-fx-text-fill: #F0F4F5; -fx-font-size: 24px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" />
            </HBox>
            <Button text="Registrar Solicitud" onAction="#onRegistrarSolicitud" maxWidth="Infinity" style="-fx-background-color: #F0F4F5; -fx-text-fill: #390007; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 18px; -fx-cursor: hand;" />
            <Label fx:id="lblMensaje" text="" wrapText="true" style="-fx-text-fill: #9BA0AB; -fx-font-style: italic;" />
        </VBox>
    </ScrollPane>

    <VBox spacing="20" HBox.hgrow="ALWAYS">
        <VBox spacing="12" VBox.vgrow="ALWAYS" style="-fx-background-color: #390007; -fx-padding: 18px; -fx-background-radius: 12px;">
            <Label text="Solicitudes Registradas" style="-fx-text-fill: #F0F4F5; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" />
            <TableView fx:id="tblSolicitudes" VBox.vgrow="ALWAYS" style="-fx-base: #390007; -fx-control-inner-background: #0E0E0F; -fx-background-color: #0E0E0F; -fx-selection-bar: #9BA0AB; -fx-selection-bar-non-focused: #9BA0AB; -fx-table-cell-border-color: transparent;">
                <columns>
                    <TableColumn fx:id="colSolCodigo" text="Código" prefWidth="90" />
                    <TableColumn fx:id="colSolCliente" text="Cliente" prefWidth="170" />
                    <TableColumn fx:id="colSolFecha" text="Creada" prefWidth="130" />
                    <TableColumn fx:id="colSolEstado" text="Estado" prefWidth="100" />
                    <TableColumn fx:id="colSolTotal" text="Total" prefWidth="110" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <VBox spacing="12" style="-fx-background-color: #390007; -fx-padding: 18px; -fx-background-radius: 12px;">
            <Label text="Detalle de la Solicitud" style="-fx-text-fill: #F0F4F5; -fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" />
            <TextArea fx:id="txtDetalle" editable="false" wrapText="true" prefHeight="190" style="-fx-control-inner-background: #0E0E0F; -fx-text-fill: #F0F4F5; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px;" />
        </VBox>
    </VBox>
</HBox>