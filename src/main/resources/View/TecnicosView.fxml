<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20" style="-fx-background-color: #0E0E0F; -fx-padding: 20px;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.uniquindio.edu.poo.viewcontroller.TecnicosViewController">
    <VBox minWidth="340" prefWidth="380" spacing="12" style="-fx-background-color: #390007; -fx-padding: 18px; -fx-background-radius: 12px;">
        <Label style="-fx-text-fill: #F0F4F5; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" text="Disponibilidad de Técnicos (LegacySupport)" wrapText="true" />
        <Label style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" text="ESPECIALIDAD" />
        <ComboBox fx:id="cmbEspecialidad" maxWidth="Infinity" promptText="Seleccione una especialidad" style="-fx-base: #0E0E0F; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px;" />
        <Button maxWidth="Infinity" onAction="#onConsultarTecnico" style="-fx-background-color: #F0F4F5; -fx-text-fill: #390007; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 9px 18px; -fx-cursor: hand;" text="Consultar Disponibilidad" />
        <Separator style="-fx-background-color: #9BA0AB;" />

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label prefWidth="120" style="-fx-text-fill: #9BA0AB;" text="Técnico:" />
            <Label fx:id="lblTecnicoId" style="-fx-text-fill: #F0F4F5; -fx-font-weight: bold;" text="-" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label prefWidth="120" style="-fx-text-fill: #9BA0AB;" text="Nombre:" />
            <Label fx:id="lblTecnicoNombre" style="-fx-text-fill: #F0F4F5; -fx-font-weight: bold;" text="-" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label prefWidth="120" style="-fx-text-fill: #9BA0AB;" text="Especialidad:" />
            <Label fx:id="lblTecnicoEspecialidad" style="-fx-text-fill: #F0F4F5; -fx-font-weight: bold;" text="-" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label prefWidth="120" style="-fx-text-fill: #9BA0AB;" text="Estado:" />
            <Label fx:id="lblTecnicoDisponibilidad" style="-fx-text-fill: #F0F4F5; -fx-font-weight: bold;" text="-" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label prefWidth="120" style="-fx-text-fill: #9BA0AB;" text="Desplazamiento:" />
            <Label fx:id="lblTecnicoDesplazamiento" style="-fx-text-fill: #F0F4F5; -fx-font-weight: bold;" text="-" />
        </HBox>
    </VBox>

    <VBox minWidth="340" prefWidth="380" spacing="10" style="-fx-background-color: #390007; -fx-padding: 18px; -fx-background-radius: 12px;">
        <Label style="-fx-text-fill: #F0F4F5; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" text="Registrar Nuevo Técnico" />

        <Label style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" text="ID DEL TÉCNICO" />
        <TextField fx:id="txtNuevoId" promptText="Ej: TEC-04" style="-fx-control-inner-background: #0E0E0F; -fx-text-fill: #F0F4F5; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px;" />

        <Label style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" text="NOMBRE COMPLETO" />
        <TextField fx:id="txtNuevoNombre" promptText="Ej: Juan Pérez" style="-fx-control-inner-background: #0E0E0F; -fx-text-fill: #F0F4F5; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px;" />

        <Label style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" text="ESPECIALIDAD" />
        <ComboBox fx:id="cmbNuevoEspecialidad" maxWidth="Infinity" promptText="Seleccione una especialidad" style="-fx-base: #0E0E0F; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px;" />

        <Label style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" text="TELÉFONO" />
        <TextField fx:id="txtNuevoTelefono" promptText="Ej: 3001234567" style="-fx-control-inner-background: #0E0E0F; -fx-text-fill: #F0F4F5; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px;" />

        <Label style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" text="COSTO DE DESPLAZAMIENTO" />
        <TextField fx:id="txtNuevoCostoDesplazamiento" promptText="Ej: 20000" style="-fx-control-inner-background: #0E0E0F; -fx-text-fill: #F0F4F5; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px;" />

        <CheckBox fx:id="chkNuevoDisponible" selected="true" style="-fx-text-fill: #F0F4F5; -fx-font-weight: bold;" text="Disponible actualmente" />

        <Button maxWidth="Infinity" onAction="#onRegistrarTecnico" style="-fx-background-color: #F0F4F5; -fx-text-fill: #390007; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 9px 18px; -fx-cursor: hand;" text="Guardar Técnico" />
    </VBox>

    <VBox spacing="12" style="-fx-background-color: #390007; -fx-padding: 18px; -fx-background-radius: 12px;" HBox.hgrow="ALWAYS">
        <Label style="-fx-text-fill: #F0F4F5; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" text="Costo Total de la Solicitud" />
        <Label style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" text="SOLICITUD" />
        <HBox alignment="CENTER_LEFT" spacing="12">
            <ComboBox fx:id="cmbSolicitud" maxWidth="Infinity" promptText="Seleccione una solicitud" style="-fx-base: #0E0E0F; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px;" HBox.hgrow="ALWAYS" />
            <Button onAction="#onCalcularCosto" style="-fx-background-color: #F0F4F5; -fx-text-fill: #390007; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 18px; -fx-cursor: hand;" text="Verificar y Calcular" />
        </HBox>
        <Label fx:id="lblEstado" style="-fx-text-fill: #9BA0AB; -fx-font-style: italic;" text="" wrapText="true" />

        <Label style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" text="DESGLOSE" />
        <TextArea fx:id="txtDesglose" editable="false" style="-fx-control-inner-background: #0E0E0F; -fx-text-fill: #F0F4F5; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px;" wrapText="true" VBox.vgrow="ALWAYS" />
        <Separator style="-fx-background-color: #9BA0AB;" />

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label prefWidth="170" style="-fx-text-fill: #9BA0AB;" text="Servicios y paquetes:" />
            <Label fx:id="lblSubtotal" style="-fx-text-fill: #F0F4F5; -fx-font-weight: bold;" text="\$0" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label prefWidth="170" style="-fx-text-fill: #9BA0AB;" text="Desplazamiento:" />
            <Label fx:id="lblDesplazamiento" style="-fx-text-fill: #F0F4F5; -fx-font-weight: bold;" text="\$0" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label prefWidth="170" style="-fx-text-fill: #9BA0AB;" text="Total:" />
            <Label fx:id="lblTotal" style="-fx-text-fill: #F0F4F5; -fx-font-size: 24px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" text="\$0" />
        </HBox>
    </VBox>
</HBox>