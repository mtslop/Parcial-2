<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20" style="-fx-background-color: #0E0E0F; -fx-padding: 20px;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.uniquindio.edu.poo.viewcontroller.ServiciosViewController">

    <VBox spacing="20" HBox.hgrow="ALWAYS">
        <VBox spacing="12" style="-fx-background-color: #390007; -fx-padding: 18px; -fx-background-radius: 12px;" VBox.vgrow="ALWAYS">
            <Label style="-fx-text-fill: #F0F4F5; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" text="Catálogo de Servicios" />
            <TableView fx:id="tblServicios" style="-fx-base: #390007; -fx-control-inner-background: #0E0E0F; -fx-background-color: #0E0E0F; -fx-selection-bar: #9BA0AB; -fx-selection-bar-non-focused: #9BA0AB; -fx-table-cell-border-color: transparent;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" prefWidth="90" text="Código" />
                    <TableColumn fx:id="colNombre" prefWidth="190" text="Servicio" />
                    <TableColumn fx:id="colDescripcion" prefWidth="250" text="Descripción" />
                    <TableColumn fx:id="colCosto" prefWidth="110" text="Costo base" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <VBox spacing="12" style="-fx-background-color: #390007; -fx-padding: 18px; -fx-background-radius: 12px;">
            <Label style="-fx-text-fill: #F0F4F5; -fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" text="Crear Nuevo Servicio" />
            <HBox spacing="15">
                <ComboBox fx:id="cmbTipo" prefWidth="240" promptText="Tipo de servicio" style="-fx-base: #0E0E0F; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px;" />
                <TextField fx:id="txtCodigo" prefWidth="200" promptText="Código (Ej: SRV-005)" style="-fx-background-color: #0E0E0F; -fx-text-fill: #F0F4F5; -fx-prompt-text-fill: #9BA0AB; -fx-background-radius: 6px; -fx-border-color: #9BA0AB; -fx-border-radius: 6px;" />
            </HBox>
            <TextField fx:id="txtDescripcion" promptText="Descripción del servicio" style="-fx-background-color: #0E0E0F; -fx-text-fill: #F0F4F5; -fx-prompt-text-fill: #9BA0AB; -fx-background-radius: 6px; -fx-border-color: #9BA0AB; -fx-border-radius: 6px;" />
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button onAction="#onCrearServicio" style="-fx-background-color: #F0F4F5; -fx-text-fill: #390007; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 18px; -fx-cursor: hand;" text="Crear Servicio" />
                <Label fx:id="lblMensajeCreacion" style="-fx-text-fill: #9BA0AB; -fx-font-style: italic;" text="" wrapText="true" />
            </HBox>
        </VBox>
    </VBox>

    <VBox minWidth="380" prefWidth="420" spacing="12" style="-fx-background-color: #390007; -fx-padding: 18px; -fx-background-radius: 12px;">
        <Label style="-fx-text-fill: #F0F4F5; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" text="Personalizar Servicio" />
        <Label style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" text="SERVICIO SELECCIONADO" />
        <Label fx:id="lblServicioSeleccionado" style="-fx-text-fill: #F0F4F5; -fx-font-size: 14px; -fx-font-weight: bold;" text="Seleccione un servicio del catálogo" wrapText="true" />
        <Separator style="-fx-background-color: #9BA0AB;" />

        <Label style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" text="CARACTERÍSTICAS COMPLEMENTARIAS" />
        <CheckBox fx:id="chkPrioritaria" onAction="#onComplementoCambiado" style="-fx-text-fill: #F0F4F5;" text="Atención prioritaria (+\$35.000)" />
        <CheckBox fx:id="chkSoporte" onAction="#onComplementoCambiado" style="-fx-text-fill: #F0F4F5;" text="Soporte técnico 30 días (+\$50.000)" />
        <CheckBox fx:id="chkDomicilio" onAction="#onComplementoCambiado" style="-fx-text-fill: #F0F4F5;" text="Atención a domicilio (+\$25.000)" />
        <Separator style="-fx-background-color: #9BA0AB;" />

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-text-fill: #9BA0AB;" text="Costo base:" />
            <Label fx:id="lblCostoBase" style="-fx-text-fill: #F0F4F5; -fx-font-weight: bold;" text="\$0" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-text-fill: #9BA0AB;" text="Incrementos:" />
            <Label fx:id="lblIncrementos" style="-fx-text-fill: #F0F4F5; -fx-font-weight: bold;" text="\$0" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-text-fill: #F0F4F5; -fx-font-size: 15px;" text="Costo final:" />
            <Label fx:id="lblCostoFinal" style="-fx-text-fill: #F0F4F5; -fx-font-size: 24px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" text="\$0" />
        </HBox>
        <Button maxWidth="Infinity" onAction="#onGuardarPersonalizado" style="-fx-background-color: #F0F4F5; -fx-text-fill: #390007; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 9px 18px; -fx-cursor: hand;" text="Guardar Servicio Personalizado" />
        <Label fx:id="lblMensajePersonalizado" style="-fx-text-fill: #9BA0AB; -fx-font-style: italic;" text="" wrapText="true" />

        <Label style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" text="SERVICIOS PERSONALIZADOS" />
        <ListView fx:id="lstPersonalizados" minHeight="100" style="-fx-base: #390007; -fx-control-inner-background: #0E0E0F; -fx-background-color: #0E0E0F; -fx-selection-bar: #9BA0AB; -fx-selection-bar-non-focused: #9BA0AB;" VBox.vgrow="ALWAYS" />
    </VBox>
</HBox>
