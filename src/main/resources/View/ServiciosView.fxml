<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<HBox spacing="20" style="-fx-background-color: #0E0E0F; -fx-padding: 20px;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="">

    <VBox spacing="20" HBox.hgrow="ALWAYS">
        <VBox spacing="12" VBox.vgrow="ALWAYS" style="-fx-background-color: #390007; -fx-padding: 18px; -fx-background-radius: 12px;">
            <Label text="Catálogo de Servicios" style="-fx-text-fill: #F0F4F5; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" />
            <TableView fx:id="tblServicios" VBox.vgrow="ALWAYS" style="-fx-base: #390007; -fx-control-inner-background: #0E0E0F; -fx-background-color: #0E0E0F; -fx-selection-bar: #9BA0AB; -fx-selection-bar-non-focused: #9BA0AB; -fx-table-cell-border-color: transparent;">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="90" />
                    <TableColumn fx:id="colNombre" text="Servicio" prefWidth="190" />
                    <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="250" />
                    <TableColumn fx:id="colCosto" text="Costo base" prefWidth="110" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <VBox spacing="12" style="-fx-background-color: #390007; -fx-padding: 18px; -fx-background-radius: 12px;">
            <Label text="Crear Nuevo Servicio" style="-fx-text-fill: #F0F4F5; -fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" />
            <HBox spacing="15">
                <ComboBox fx:id="cmbTipo" promptText="Tipo de servicio" prefWidth="240" style="-fx-base: #0E0E0F; -fx-background-color: #0E0E0F; -fx-border-color: #9BA0AB; -fx-border-radius: 6px; -fx-background-radius: 6px;" />
                <TextField fx:id="txtCodigo" promptText="Código (Ej: SRV-005)" prefWidth="200" style="-fx-background-color: #0E0E0F; -fx-text-fill: #F0F4F5; -fx-prompt-text-fill: #9BA0AB; -fx-background-radius: 6px; -fx-border-color: #9BA0AB; -fx-border-radius: 6px;" />
            </HBox>
            <TextField fx:id="txtDescripcion" promptText="Descripción del servicio" style="-fx-background-color: #0E0E0F; -fx-text-fill: #F0F4F5; -fx-prompt-text-fill: #9BA0AB; -fx-background-radius: 6px; -fx-border-color: #9BA0AB; -fx-border-radius: 6px;" />
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button text="Crear Servicio" onAction="#onCrearServicio" style="-fx-background-color: #F0F4F5; -fx-text-fill: #390007; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 18px; -fx-cursor: hand;" />
                <Label fx:id="lblMensajeCreacion" text="" wrapText="true" style="-fx-text-fill: #9BA0AB; -fx-font-style: italic;" />
            </HBox>
        </VBox>
    </VBox>

    <VBox spacing="12" prefWidth="420" minWidth="380" style="-fx-background-color: #390007; -fx-padding: 18px; -fx-background-radius: 12px;">
        <Label text="Personalizar Servicio" style="-fx-text-fill: #F0F4F5; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" />
        <Label text="SERVICIO SELECCIONADO" style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" />
        <Label fx:id="lblServicioSeleccionado" text="Seleccione un servicio del catálogo" wrapText="true" style="-fx-text-fill: #F0F4F5; -fx-font-size: 14px; -fx-font-weight: bold;" />
        <Separator style="-fx-background-color: #9BA0AB;" />

        <Label text="CARACTERÍSTICAS COMPLEMENTARIAS" style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" />
        <CheckBox fx:id="chkPrioritaria" text="Atención prioritaria (+\$35.000)" onAction="#onComplementoCambiado" style="-fx-text-fill: #F0F4F5;" />
        <CheckBox fx:id="chkSoporte" text="Soporte técnico 30 días (+\$50.000)" onAction="#onComplementoCambiado" style="-fx-text-fill: #F0F4F5;" />
        <CheckBox fx:id="chkDomicilio" text="Atención a domicilio (+\$25.000)" onAction="#onComplementoCambiado" style="-fx-text-fill: #F0F4F5;" />
        <Separator style="-fx-background-color: #9BA0AB;" />

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Costo base:" style="-fx-text-fill: #9BA0AB;" />
            <Label fx:id="lblCostoBase" text="\$0" style="-fx-text-fill: #F0F4F5; -fx-font-weight: bold;" />
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Incrementos:" style="-fx-text-fill: #9BA0AB;" />
            <Label fx:id="lblIncrementos" text="\$0" style="-fx-text-fill: #F0F4F5; -fx-font-weight: bold;" />
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Costo final:" style="-fx-text-fill: #F0F4F5; -fx-font-size: 15px;" />
            <Label fx:id="lblCostoFinal" text="\$0" style="-fx-text-fill: #F0F4F5; -fx-font-size: 24px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" />
        </HBox>
        <Button text="Guardar Servicio Personalizado" onAction="#onGuardarPersonalizado" maxWidth="Infinity" style="-fx-background-color: #F0F4F5; -fx-text-fill: #390007; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 9px 18px; -fx-cursor: hand;" />
        <Label fx:id="lblMensajePersonalizado" text="" wrapText="true" style="-fx-text-fill: #9BA0AB; -fx-font-style: italic;" />

        <Label text="SERVICIOS PERSONALIZADOS" style="-fx-text-fill: #9BA0AB; -fx-font-size: 11px; -fx-font-weight: bold;" />
        <ListView fx:id="lstPersonalizados" VBox.vgrow="ALWAYS" minHeight="100" style="-fx-base: #390007; -fx-control-inner-background: #0E0E0F; -fx-background-color: #0E0E0F; -fx-selection-bar: #9BA0AB; -fx-selection-bar-non-focused: #9BA0AB;" />
    </VBox>
</HBox>